/// Convert name to html format
/// @param s string
/// @return string
macro convertName(s)
	$s.replace(([A-Z]), -%1, ?rich).lower()
end

/// Escape an html string
/// @param s string
/// @return string
macro escapeHTML(s)
	set s = $String($s)
	$s.replace(&, &amp;).replace(<, &lt;).replace(>, &gt;).replace(", &quot;)
end

/// Custom type handler
/// @param x any
/// @return string
macro getType(x)
	if type(x) == "table"
		$(x.type? or "table")
	else
		$type($x)
	end
end

/// Representation of an HTML tag
/// Read-only
/// @public
/// @param name string
/// @param content string
/// @param autoClose flag <input/> tag-like
/// @param noClose flag <img> tag-like. Exclusive with autoClose
/// @param safe flag If true, doesn't escape content.
/// @param ...attrs table Map of tag attributes.
///	*	Notes on attrs:
///		*	Cannot use autoClose, noClose, safe as attribute.
///		*	Map keys should be string.
///		*	Map keys will be converted from `thisIsAnAttribute` to `this-is-an-attribute`
///		*	Map values should be string, or table with a tostring meta-method, or boolean
/// @return string
macro Tag (name, content, ?autoClose, ?noClose, ?safe, ...attrs)
	type: node
	ref render: macro(?isSafe)
		let escape = $(not isSafe and not safe)

		if autoClose and noClose
			// Waiting for implementation of std error
		end

		set name = $escapeHTML($name)
		
		<$name
			for key, value in items(attrs)
				set key = $escapeHTML($convertName($key))
				if value==true
					\s$key
				else
					\s$key="$escapeHTML($value)"
				end
			end
			if autoClose
				/
			end
		>
			if getType(content) == "node"
				$content.render(isSafe: $(not escape))
			elseif escape
				$escapeHTML($content)
			else
				$content
			end

		if not autoClose and not noClose
		</$name>
		end
	end
	meta tostring: $render
end

let tagNames = @table
	- Div
	- Span
	- Section
	- Article
	- Header
	- Footer
	- P
	- Pre
	- Blockquote
	- A
	- Nav
	- Ul
	- Ol
	- Li
	- Table
	- Thead
	- Tbody
	- Tr
	- Th
	- Td
	- Style
	- Script
	- Html
	- Center
	- Strong
	- Em
	- Title
	- Head
	- Body
	for i in seq(6)
		- H$i
	end
end

let tagNamesNoClose = @table
	- Img
	- Br
	- Input
	- Hr
end

Tag: $Tag
for name in tagNames
	$name: macro(...args)
		$Tag($name.lower(), ...args)
	end
end

for name in tagNamesNoClose
	$name: macro(...args)
		$Tag($name.lower(), ...args, ?noClose)
	end
end