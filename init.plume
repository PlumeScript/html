let css from $import(css)

/// Convert name to html format
/// @param s string
/// @return string
macro convertName(s)
	$s.replace(([A-Z]), -%1, ?rich).lower()
end

/// Escape an html string
/// @param s string
/// @return string
macro escapeHTML(s)
	set s = $String($s)
	$s.replace(&, &amp;).replace(<, &lt;).replace(>, &gt;).replace(", &quot;)
end

/// Representation of an HTML tag
/// Read-only
/// @public
/// @param name string
/// @param content string
/// @param autoClose flag <input/> tag-like
/// @param noClose flag <img> tag-like. Exclusive with autoClose
/// @param safe flag If true, doesn't escape content.
/// @param ...attrs table Map of tag attributes.
///	*	Notes on attrs:
///		*	Cannot use autoClose, noClose, safe as attribute.
///		*	Map keys should be string.
///		*	Map keys will be converted from `thisIsAnAttribute` to `this-is-an-attribute`
///		*	Map values should be string, or table with a tostring meta-method, or boolean
/// @return string
macro Tag (name, content, ?autoClose, ?noClose, ...attrs)
	if autoClose and noClose
		// Waiting for implementation of std error
	end

	set name = $escapeHTML($name)
	
	<$name
		for key, value in items(attrs)
			set key = $escapeHTML($convertName($key))
			
			if key == "style" and type(value) == "table"
				set value = $css(...value)
			end

			if value==true
				\s$key
			else
				\s$key="$escapeHTML($value)"
			end
		end
		if autoClose
			/
		end
	>
		$content

	if not autoClose and not noClose
	</$name>
	end
end

/// Output the doctype
/// @public
/// @param doctype string
/// @return string
Doctype: macro(doctype)
	<!DOCTYPE $doctype>
end

/// Escape given text
/// @public
/// @param 
Text: macro(content)
	$escapeHTML($content)
end

let tagNames = do
	- Div
	- Span
	- Section
	- Article
	- Header
	- Footer
	- P
	- Pre
	- Blockquote
	- A
	- Nav
	- Ul
	- Ol
	- Li
	- Table
	- Thead
	- Tbody
	- Tr
	- Th
	- Td
	- Style
	- Script
	- Html
	- Center
	- Strong
	- Em
	- Title
	- Head
	- Body
	for i in seq(6)
		- H$i
	end
end

let tagNamesNoClose = do
	- Img
	- Br
	- Input
	- Hr
end

Tag: $Tag
for name in tagNames
	$name: macro(...args)
		$Tag($name.lower(), ...args)
	end
end

for name in tagNamesNoClose
	$name: macro(...args)
		$Tag($name.lower(), $empty, ?noClose, ...args)
	end
end